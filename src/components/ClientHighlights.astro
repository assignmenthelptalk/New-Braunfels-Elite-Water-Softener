---
/**
 * ClientHighlights: the credentials strip under the homepage hero (trust badge, years in business, warranty),
 * the guarantee callout and the reviews line. Reads only src/lib/clientMode.ts. A value that is null is not
 * rendered at all (no empty element, nothing hidden by CSS), so placeholder mode carries no unsupported claim.
 */
import { trustBadge, yearsLabel, warrantyLabel, guaranteeText, reviewsBlock } from "../lib/clientMode";

const credentials = [trustBadge, yearsLabel, warrantyLabel].filter((v): v is string => Boolean(v));
---

<section class="client-highlights" aria-label="Why choose us">
  <div class="container client-highlights-inner">
    <ul class="ch-list">
      {credentials.map((item) => <li>✓ {item}</li>)}
    </ul>
    {guaranteeText && <p class="ch-guarantee"><strong>Our guarantee:</strong> {guaranteeText}</p>}
    {reviewsBlock && (
      <p class="ch-reviews">
        <span class="ch-stars" aria-hidden="true">{reviewsBlock.stars}</span>
        {reviewsBlock.url
          ? <a href={reviewsBlock.url} rel="noopener">{reviewsBlock.label}</a>
          : <span>{reviewsBlock.label}</span>}
      </p>
    )}
  </div>
</section>

<style>
  .client-highlights { background: var(--color-primary-light); padding-block: 18px; }
  .client-highlights-inner { display: grid; gap: 12px; }
  .ch-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 22px; font-weight: 600; color: var(--color-primary); }
  .ch-guarantee { margin: 0; padding: 12px 16px; border-left: 4px solid var(--color-accent); background: #fff; border-radius: 6px; }
  .ch-reviews { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .ch-stars { color: var(--color-accent); letter-spacing: 2px; font-size: 1.15rem; }
  .ch-reviews a { color: var(--color-primary); font-weight: 600; }
</style>
