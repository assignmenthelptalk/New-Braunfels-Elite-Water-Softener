---
/**
 * ContentProse: typography wrapper for imported markdown pages.
 * Scoped styles reach the rendered markdown through :global selectors.
 * [NEEDS DATA] / [VERIFY] markers render as <mark class="data-gap"> and are
 * deliberately loud so unresolved facts cannot be missed in review.
 */
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    max-width: 780px;
    margin: 0 auto;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: var(--color-text);
  }

  .prose :global(h2) {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    margin: 2.6em 0 0.6em;
    padding-top: 0.9em;
    border-top: 3px solid var(--color-accent);
    max-width: 32ch;
  }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) {
    font-size: 1.3rem;
    margin: 1.8em 0 0.4em;
  }
  .prose :global(p) { margin: 0 0 1.1em; line-height: 1.75; }
  .prose :global(ul),
  .prose :global(ol) { margin: 0 0 1.4em; padding-left: 1.4em; }
  /* Tailwind's preflight resets list styles; restore them for article copy */
  .prose :global(ul) { list-style: disc; }
  .prose :global(ol) { list-style: decimal; }
  .prose :global(li) { margin-bottom: 0.55em; line-height: 1.7; }
  .prose :global(li::marker) { color: var(--color-accent); font-weight: 700; }
  .prose :global(strong) { color: var(--color-text); }

  .prose :global(a) {
    color: var(--color-primary);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    font-weight: 600;
  }
  .prose :global(a:hover) { color: var(--color-accent-dark); }

  /* Trust-layer callouts ("Not a good fit if...", "What owners tell us") */
  .prose :global(blockquote) {
    margin: 1.6em 0;
    padding: 18px 22px;
    background: var(--color-primary-light);
    border-left: 4px solid var(--color-primary);
    border-radius: 0 var(--radius-brand) var(--radius-brand) 0;
    box-shadow: var(--shadow-card);
  }
  .prose :global(blockquote p:last-child) { margin-bottom: 0; }

  /* Comparison / price tables */
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.6em 0;
    font-size: 0.95rem;
    background: var(--surface-base);
    box-shadow: var(--shadow-card);
    border-radius: var(--radius-brand);
    overflow: hidden;
    display: block;
    overflow-x: auto;
  }
  .prose :global(th) {
    background: var(--color-primary);
    color: #ffffff;
    text-align: left;
    padding: 12px 14px;
    font-weight: 600;
  }
  .prose :global(td) {
    padding: 12px 14px;
    border-top: 1px solid var(--color-border);
    vertical-align: top;
  }
  .prose :global(tr:nth-child(even) td) { background: var(--surface-elevated); }

  .prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 1.8em 0;
    border-radius: var(--radius-brand);
    box-shadow: var(--shadow-card);
  }

  /* Unresolved facts: loud on purpose */
  .prose :global(mark.data-gap),
  :global(mark.data-gap) {
    background: #fff3b0;
    color: #5c4300;
    padding: 1px 6px;
    border-radius: 4px;
    outline: 1px dashed #b88700;
    font-size: 0.9em;
    font-weight: 600;
  }

  /* Homepage services: a 3-column card grid that breaks out of the 780px text column */
  .prose :global(.svc-grid) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.2rem 2rem;
    width: min(1100px, calc(100vw - 2rem));
    margin: 1.8rem 0 1.8rem 50%;
    transform: translateX(-50%);
  }
  .prose :global(.svc-card > p:first-child) { margin: 0 0 1rem; }
  .prose :global(.svc-card img) { margin: 0; aspect-ratio: 3 / 2; object-fit: cover; box-shadow: none; }
  .prose :global(.svc-card h3) { margin: 0 0 0.5rem; font-size: 1.2rem; }
  .prose :global(.svc-card p) { font-size: 0.97rem; line-height: 1.65; margin: 0; }
  @media (max-width: 900px) { .prose :global(.svc-grid) { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .prose :global(.svc-grid) { grid-template-columns: 1fr; } }

  @media (max-width: 640px) {
    .prose { font-size: 1rem; }
    .prose :global(h2) { max-width: none; }
  }
</style>
