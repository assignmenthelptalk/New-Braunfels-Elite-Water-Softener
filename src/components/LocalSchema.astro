---
/**
 * LocalSchema: emits the business JSON-LD (schema.org HomeAndConstructionBusiness, a LocalBusiness type)
 * on every page from Layout. Reads only src/lib/site.ts (site.config.ts) and src/data/map-points.json,
 * so it is identical for every page and correct once a city is provisioned.
 *
 * Nothing unconfirmed is published: a placeholder phone ("PHONE_NUMBER" or a number such as
 * (830) 000-0000), a placeholder email, an empty address and unknown hours are all left out.
 * `geo` is the city centre from map-points.json (OpenStreetMap), which is the right point for a
 * service-area business. Add openingHoursSpecification only when the business confirms real hours.
 */
import { site } from "../lib/site";
import { phone, schemaAddress, legalName, licences, googleProfileUrl, priceRangeSchema, reviewsBlock } from "../lib/clientMode";
import mapData from "../data/map-points.json";

const center = (mapData as { center: { lat: number; lng: number } | null }).center;

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  name: site.businessName,
  url: site.siteUrl,
  legalName: legalName || undefined,
  telephone: phone ?? undefined,
  email: site.businessEmail !== "BUSINESS_EMAIL" ? site.businessEmail : undefined,
  address: schemaAddress ?? undefined,
  identifier: licences.length
    ? licences.map((l) => ({ "@type": "PropertyValue", name: l.body + " licence", value: l.number }))
    : undefined,
  geo: schemaAddress && center ? { "@type": "GeoCoordinates", latitude: center.lat, longitude: center.lng } : undefined,
  areaServed: [
    ...(site.serviceArea
      ? [{
          "@type": "GeoCircle",
          geoMidpoint: { "@type": "GeoCoordinates", latitude: site.serviceArea.lat, longitude: site.serviceArea.lng },
          geoRadius: Math.round(site.serviceArea.radiusMiles * 1609.34), // metres
        }]
      : []),
    ...[site.city, ...site.neighbourhoods].map((name) => ({ "@type": "City", name })),
  ],
  serviceType: "Water Softener Installation & Water Treatment",
  priceRange: priceRangeSchema ?? undefined,
  aggregateRating: reviewsBlock
    ? { "@type": "AggregateRating", ratingValue: reviewsBlock.rating, reviewCount: reviewsBlock.count, bestRating: 5, worstRating: 1 }
    : undefined,
  sameAs: [googleProfileUrl, ...Object.values(site.socialLinks ?? {})].filter(Boolean).length
    ? [googleProfileUrl, ...Object.values(site.socialLinks ?? {})].filter(Boolean)
    : undefined,
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
